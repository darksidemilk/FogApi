<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <!--
      NOT "FogApi". A nested binary module takes its module name from the
      assembly, so FogApi.dll gives the script module and its nested module the
      same name, and Get-Module FogApi then returns TWO modules in any scope
      that sees both. Pester is such a scope: `$mod = Get-Module FogApi;
      & $mod { ... }` bound an array, and PowerShell tried to run a command
      literally called "FogApi FogApi FogApi". 46 tests failed that way.

      Microsoft's own modules avoid it the same way. PSReadLine ships
      Microsoft.PowerShell.PSReadLine2.dll, deliberately not PSReadLine.dll.

      This name also drives the help file. PowerShell looks for a compiled
      cmdlet's MAML at <ModuleBase>/<culture>/<AssemblyName>.dll-Help.xml, and
      the assembly-name form is required even for a nested module. So it is
      FogApi.Core.dll-Help.xml, and that exact string is what the emitter must
      write into each markdown file's `external help file` frontmatter.
      Renaming the assembly silently detaches every cmdlet from its help.

      RootNamespace stays FogApi: the namespace callers type is independent of
      the file the types live in.
    -->
    <AssemblyName>FogApi.Core</AssemblyName>
    <RootNamespace>FogApi</RootNamespace>

    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>

    <!--
      System, System.IO, System.Linq, System.Collections.Generic,
      System.Net.Http and System.Threading.Tasks without a using line in every
      file. Worth having before the emitter starts writing 200 of them: a
      per-file using block is 200 identical lines to keep in step, and getting
      one wrong is a compile error in generated code, which is the least
      pleasant place to debug one.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      A library loaded into a host that already exists. No apphost, no runtime
      copied alongside, no satellite resource folders.
    -->
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      A build that differs run to run would make the drift gate a coin flip,
      the same reason Build-FogApiSpec sorts its output before writing.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets="all" is the whole dependency story. Without it, publish
      drags System.Management.Automation and its closure (some 200 files) into
      the module payload. With it the output is FogApi.dll and nothing else,
      because System.Net.Http and System.Text.Json are already in the net8.0
      framework.

      Zero third-party packages is a constraint, not an accident: assemblies
      shipped inside a PowerShell module conflict with whatever else the session
      has loaded, and that class of bug has no good fix. If a dependency ever
      becomes unavoidable, that is the point at which an AssemblyLoadContext
      becomes necessary, and not before.

      The concrete SDK package rather than PowerShellStandard.Library, because
      5.1 is dropped and this wants PS7 only APIs (IArgumentCompleter with
      CompletionResultType, IValidateSetValuesGenerator).
    -->
    <PackageReference Include="System.Management.Automation" Version="7.4.6" PrivateAssets="all" />
  </ItemGroup>

</Project>
